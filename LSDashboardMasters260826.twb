    <worksheet name='Ethinicity equity'>
      <table>
        <view>
          <datasources>
            <datasource caption='ethnicity_equity_gaps' name='federated.0686sdm0nbhqce0zp80eb1np2fg1' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='Absolutre Value' caption='Session ' datatype='boolean' name='[Parameter 2]' param-domain-type='list' role='measure' type='nominal' value='false'>
              <calculation class='tableau' formula='false' />
              <aliases>
                <alias key='false' value='Absolutre Value' />
                <alias key='true' value='Percentage' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0686sdm0nbhqce0zp80eb1np2fg1'>
            <column caption='Borough Total Gap' datatype='real' name='[Calculation_6283194523189249]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [borough] : SUM(ABS([gap])) }' />
            </column>
            <column caption='Gap Display' datatype='real' name='[Calculation_6283194854567942]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#13;&#10;    AVG([gap])&#13;&#10;ELSE&#13;&#10;    (AVG([group_inactive]) - AVG([borough_overall_inactive])) / 100 * AVG([total_respondents])&#13;&#10;END' />
            </column>
            <column-instance column='[n_years_pooled]' derivation='Avg' name='[avg:n_years_pooled:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_respondents]' derivation='Avg' name='[avg:total_respondents:qk]' pivot='key' type='quantitative' />
            <column caption='Borough' datatype='string' name='[borough]' role='dimension' type='nominal' />
            <column caption='Borough Overall Inactive' datatype='real' name='[borough_overall_inactive]' role='measure' type='quantitative' />
            <column caption='Ethnic Group' datatype='string' name='[ethnic_group]' role='dimension' type='nominal' />
            <column caption='Gap' datatype='real' name='[gap]' role='measure' type='quantitative' />
            <column caption='Group Inactive' datatype='real' name='[group_inactive]' role='measure' type='quantitative' />
            <column caption='N Years Pooled' datatype='integer' name='[n_years_pooled]' role='measure' type='quantitative' />
            <column-instance column='[borough]' derivation='None' name='[none:borough:nk]' pivot='key' type='nominal' />
            <column-instance column='[ethnic_group]' derivation='None' name='[none:ethnic_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[reliable]' derivation='None' name='[none:reliable:nk]' pivot='key' type='nominal' />
            <column caption='Reliable' datatype='boolean' name='[reliable]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_6283194523189249]' derivation='Sum' name='[sum:Calculation_6283194523189249:qk]' pivot='key' type='quantitative' />
            <column caption='Total Respondents' datatype='real' name='[total_respondents]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_6283194854567942]' derivation='User' name='[usr:Calculation_6283194854567942:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <computed-sort column='[federated.0686sdm0nbhqce0zp80eb1np2fg1].[none:borough:nk]' direction='DESC' using='[federated.0686sdm0nbhqce0zp80eb1np2fg1].[sum:Calculation_6283194523189249:qk]' />
          <filter class='categorical' column='[federated.0686sdm0nbhqce0zp80eb1np2fg1].[none:reliable:nk]'>
