      <column caption='Borough Total Gap' datatype='real' name='[Calculation_6283194523189249]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [borough] : SUM(ABS([gap])) }' />
      </column>
      <column caption='Gap Display' datatype='real' name='[Calculation_6283194854567942]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] THEN&#13;&#10;    AVG([gap])&#13;&#10;ELSE&#13;&#10;    (AVG([group_inactive]) - AVG([borough_overall_inactive])) / 100 * AVG([total_respondents])&#13;&#10;END' />
      </column>
