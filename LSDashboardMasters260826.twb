              <calculation class='tableau' formula='&quot;This borough is classified as &apos;&quot; +&#13;&#10;CASE [Parameters].[Parameter 1]&#13;&#10;    WHEN &quot;Tertile&quot; THEN [class]&#13;&#10;    WHEN &quot;Median&quot; THEN [class_median]&#13;&#10;    WHEN &quot;Quartile&quot; THEN [class_quartile]&#13;&#10;    ELSE [class]&#13;&#10;END +&#13;&#10;&quot;&apos;. Its inactivity rate is &quot; +&#13;&#10;STR(ROUND([inactive],1)) +&#13;&#10;&quot;%, &quot; +&#13;&#10;IF [inactive] &gt; { FIXED : AVG([inactive]) } THEN &quot;above&quot; ELSE &quot;below&quot; END +&#13;&#10;&quot; the London average. Equity concern level: &quot; + [concern] +&#13;&#10;&quot;. &quot; +&#13;&#10;IF [stable] THEN &quot;This classification is stable across sensitivity testing.&quot;&#13;&#10;ELSE &quot;Note: this borough&apos;s classification is sensitive to the threshold method used.&quot;&#13;&#10;END +&#13;&#10;IF NOT ISNULL([note]) AND [note] &lt;&gt; &quot;&quot; THEN &quot; Analyst override: &quot; + [note] ELSE &quot;&quot; END' />
            </column>
            <column caption='Borough' datatype='string' name='[borough]' role='dimension' type='nominal' />
            <column caption='Class' datatype='string' name='[class]' role='dimension' type='nominal' />
